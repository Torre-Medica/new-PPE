                "cancel",
                "{{paymentSessionId}}"
              ]
            },
            "description": "Cancela una sesion activa. Roles: Admin, Operator."
          }
        },
        {
          "name": "Register Cash",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
