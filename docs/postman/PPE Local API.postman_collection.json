{
  "info": {
    "_postman_id": "1f3fb50b-4a40-4ee0-8f78-73f7bda1b534",
    "name": "PPE Local API",
    "description": "Coleccion Postman para el backend local del PPE. Usa x-api-key y variables para alternar entre admin, operator y audit.",
