        },
        {
          "name": "Cancel Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/cancel/{{paymentSessionId}}",
