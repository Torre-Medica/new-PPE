      "key": "baseUrl",
      "value": "http://localhost:3100/api"
    },
    {
      "key": "apiKey",
      "value": "{{adminApiKey}}"
    },
    {
      "key": "adminApiKey",
      "value": "ppe-admin-local"
    },
    {
      "key": "operatorApiKey",
      "value": "ppe-operator-local"
    },
    {
      "key": "auditApiKey",
      "value": "ppe-audit-local"
    },
    {
      "key": "paymentSessionId",
      "value": "replace-session-id"
    },
    {
      "key": "qrCode",
      "value": "qr-live-001"
    }
  ],
