              "mode": "raw",
              "raw": "{\n  \"denominationId\": 2000,\n  \"quantity\": 2,\n  \"createdBy\": \"postman-operator\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentSessionId}}/cash",
              "host": [
                "{{baseUrl}}"
