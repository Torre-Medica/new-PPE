          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/sync/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "sync",
                "retry"
              ]
            },
            "description": "Reintenta pagos pendientes de sincronizar. Roles: Admin, Operator."
