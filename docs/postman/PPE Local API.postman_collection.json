    {
      "name": "Payments",
      "item": [
        {
          "name": "Start Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetAmount\": 7000,\n  \"qrCode\": \"{{qrCode}}\",\n  \"vehiclePlate\": \"ABC123\",\n  \"vehicleType\": \"CAR\",\n  \"identificationType\": \"CC\",\n  \"identificationCode\": \"123456789\",\n  \"concept\": \"Pago parqueadero\",\n  \"serverProcessId\": 101,\n  \"metadataJson\": \"{\\\"source\\\":\\\"postman\\\"}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "start"
              ]
