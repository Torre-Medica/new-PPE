NODE_ENV=development
PORT=3100
FRONTEND_PORT=5173
API_PREFIX=api # prefijo de api base api/
DATABASE_PATH=./data/ppe.sqlite
TYPEORM_LOGGING=false
FACTURACION=false
MENSUALIDADES=false
PRINTER_JAVA_SERVER_URL=http://localhost:8080/imprimir
PRINTER_NAME=printer
# Espacios de margen izquierdo en el ticket (subir si la impresora corta el borde izquierdo)
PRINTER_LEFT_PADDING=1
PPE_MACHINE_NAME=PPE1

# nexo_back - mismo equipo, puerto 3009
SERVER_LINK_URL=http://localhost:3009
SERVER_LINK_NAMESPACE=/

# UUID registrado en la tabla incomepoint de nexo_back
PPE_DEVICE_UUID=a3f5d891-7c42-4b8e-9d06-1e2f3a4b5c6d
PPE_DEVICE_SECRET=ppe-local-dev-secret
NEXO_BACK_KEY_CRYPTO=

# Claves de la API local (x-api-key)
LOCAL_API_ADMIN_KEY=ppe-admin-local
LOCAL_API_OPERATOR_KEY=ppe-operator-local
LOCAL_API_AUDIT_KEY=ppe-audit-local

# JWT del panel admin del PPE
PPE_JWT_SECRET=CHANGE-THIS-PPE-JWT-SECRET-FOR-PROD-USE
PPE_JWT_EXPIRES_IN=4h

# Tiempos de espera centralizados (en milisegundos) - controlan tanto el
# auto-cancelado del backend como los contadores que ve el usuario en cada
# pantalla del PPE. El frontend los lee de GET /kiosk/state, asi que basta
# con cambiarlos aqui para que se reflejen en todas las vistas.
# Vista: escaneo de QR/cedula, mientras se valida contra nexo_back
PAYMENT_SESSION_VALIDATING_TIMEOUT_MS=15000
# Vista: revision del pago (monto a cobrar) antes de insertar efectivo
PAYMENT_SESSION_REVIEW_TIMEOUT_MS=30000
# Vista: recepcion de efectivo (pantalla de "Inserte el dinero")
PAYMENT_SESSION_CASH_TIMEOUT_MS=30000
# Vista: ingreso de datos de facturacion electronica (documento del tercero)
PAYMENT_SESSION_BILLING_DETAILS_TIMEOUT_MS=300000
# Vista: revision del pago de mensualidad (placa, monto, fecha fin)
PAYMENT_SESSION_MONTHLY_SUBSCRIPTION_TIMEOUT_MS=120000
# Vista: pantalla final de "Gracias por su pago" antes de volver al inicio
PAYMENT_SESSION_FINALIZING_TIMEOUT_MS=30000

# Hardware - vacio para pruebas sin perifericos fisicos
# SIMULATE_HARDWARE=true evita abrir puertos seriales reales y reporta
# billetero/placa/QR/impresora como CONECTADOS de inmediato (solo para pruebas)
SIMULATE_HARDWARE=false
BILL_VALIDATOR_LEGACY_PATH=
ELECTRONIC_BOARD_LEGACY_PATH=
QR_SCANNER_PORT=COM4
QR_SCANNER_BAUD_RATE=115200
# Cooldown en ms: si el lector reporta el MISMO codigo QR otra vez antes de que
# pase este tiempo, se ignora (evita sesiones/validaciones duplicadas mientras
# el codigo sigue frente al sensor). No confundir con PAYMENT_SESSION_VALIDATING_TIMEOUT_MS,
# que es el timeout de la sesion ya creada, no de la lectura del hardware.
QR_SCANNER_DUPLICATE_COOLDOWN_MS=4000
BILL_VALIDATOR_PORT=
ELECTRONIC_BOARD_PORT=COM3

# Identificadores USB fijos - el PPE encuentra el dispositivo aunque cambie el numero COM
ELECTRONIC_BOARD_USB_VID=067B
ELECTRONIC_BOARD_USB_PID=2303
QR_SCANNER_USB_VID=26F1
QR_SCANNER_USB_PID=5650
BILL_VALIDATOR_USB_VID=
BILL_VALIDATOR_USB_PID=
