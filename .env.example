NODE_ENV=development
PORT=3100
FRONTEND_PORT=5173
API_PREFIX=api # prefijo de api base api/
DATABASE_PATH=./data/ppe.sqlite
TYPEORM_LOGGING=false
FACTURACION=false
MENSUALIDADES=false
PRINTER_JAVA_SERVER_URL=http://localhost:8080/imprimir
PRINTER_NAME=printer
PPE_MACHINE_NAME=PPE1

# nexo_back - mismo equipo, puerto 3009
SERVER_LINK_URL=http://localhost:3009
SERVER_LINK_NAMESPACE=/

# UUID registrado en la tabla incomepoint de nexo_back
PPE_DEVICE_UUID=a3f5d891-7c42-4b8e-9d06-1e2f3a4b5c6d
PPE_DEVICE_SECRET=ppe-local-dev-secret
NEXO_BACK_KEY_CRYPTO=

# Claves de la API local (x-api-key)
LOCAL_API_ADMIN_KEY=ppe-admin-local
LOCAL_API_OPERATOR_KEY=ppe-operator-local
LOCAL_API_AUDIT_KEY=ppe-audit-local

# Hardware - vacio para pruebas sin perifericos fisicos
# SIMULATE_HARDWARE=true evita abrir puertos seriales reales y reporta
# billetero/placa/QR/impresora como CONECTADOS de inmediato (solo para pruebas)
SIMULATE_HARDWARE=false
BILL_VALIDATOR_LEGACY_PATH=
ELECTRONIC_BOARD_LEGACY_PATH=
QR_SCANNER_PORT=COM4
QR_SCANNER_BAUD_RATE=115200
BILL_VALIDATOR_PORT=
ELECTRONIC_BOARD_PORT=COM3

# Identificadores USB fijos - el PPE encuentra el dispositivo aunque cambie el numero COM
ELECTRONIC_BOARD_USB_VID=067B
ELECTRONIC_BOARD_USB_PID=2303
QR_SCANNER_USB_VID=26F1
QR_SCANNER_USB_PID=5650
